<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>HTML Editor Preview</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        .container {
            display: flex;
            gap: 20px;
        }

        .box {
            width: 50%;
        }

        textarea {
            width: 100%;
            height: 400px;
            padding: 10px;
            font-family: monospace;
            font-size: 14px;
            border: 1px solid #ccc;
        }

        .editor {
            width: 100%;
            min-height: 400px;
            padding: 10px;
            border: 1px solid #ccc;
            background: #fff;
        }

        button {
            margin-top: 20px;
            padding: 10px 20px;
            cursor: pointer;
        }

        .title {
            font-weight: bold;
            margin-bottom: 10px;
        }
    </style>
</head>

<body>

<h2>HTML Render Editor</h2>

<div class="container">

    <div class="box">
        <div class="title">
            HTML Input
        </div>

        <textarea id="htmlInput">
<h1>Hello World</h1>
<p>
    Đây là nội dung HTML mẫu.
</p>

<ul>
    <li>Item 1</li>
    <li>Item 2</li>
</ul>
        </textarea>

        <button onclick="renderHTML()">
            Render HTML
        </button>
    </div>


    <div class="box">
        <div class="title">
            Content Editable Preview
        </div>

        <div 
            id="editor"
            class="editor"
            contenteditable="true">
        </div>

    </div>

</div>


<script>

function renderHTML() {

    const html = document.getElementById("htmlInput").value;

    const editor = document.getElementById("editor");

    // Render HTML
    editor.innerHTML = html;

}

</script>

</body>
</html>